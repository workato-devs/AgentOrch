# Site-specific settings for the training launchers (training/src/**/*.sbatch).
#
# Copy this file to training/scripts/env.sh (gitignored) and edit the values
# for your cluster. Every launcher sources it relative to its own location, so
# jobs can be submitted from any directory. Values already present in the
# environment win over the defaults below.

# --- interpreters ---------------------------------------------------------
# SFT environment (training/requirements-sft.txt): torch 2.13, peft, trl.
export AGENTORCH_TRAIN_PYTHON="${AGENTORCH_TRAIN_PYTHON:-$HOME/.conda/envs/agentorch-train/bin/python}"
# RL environment (training/requirements-rl.txt): verl 0.9, vllm 0.27, trl.
export AGENTORCH_RL_PYTHON="${AGENTORCH_RL_PYTHON:-$HOME/.conda/envs/agentorch-rl/bin/python}"
# Benchmark environment (benchmark/requirements.txt) used to score checkpoints.
export AGENTORCH_CONDA_BIN="${AGENTORCH_CONDA_BIN:-$HOME/.conda/envs/benchmark/bin}"
export AGENTORCH_PYTHON="${AGENTORCH_PYTHON:-$AGENTORCH_CONDA_BIN/python}"

# --- caches and credentials ------------------------------------------------
# Hugging Face cache for base checkpoints.
export HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"
# dotenv file with WANDB_API_KEY (optional) and the provider keys the
# benchmark evaluator may need. Never committed.
export AGENTORCH_ENV_FILE="${AGENTORCH_ENV_FILE:-$AGENTORCH_ROOT/.env}"

# --- optional CUDA toolkit for vLLM's runtime kernel builds -----------------
# Leave empty to use whatever nvcc is already on PATH.
export AGENTORCH_CUDA_HOME="${AGENTORCH_CUDA_HOME:-}"
export AGENTORCH_CUDA_STUBS="${AGENTORCH_CUDA_STUBS:-}"
