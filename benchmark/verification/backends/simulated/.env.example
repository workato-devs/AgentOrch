# The simulated benchmark needs no connector credentials.
#
# Copy this file to .env only if you want to override the deterministic labels
# used in output artifacts. These values never authorize an external request.
SLACK_CHANNEL_OVERRIDE=C_SIMULATED
SHEETS_SPREADSHEET_ID=simulated-spreadsheet
SHEETS_TAB=Sheet1
SNOWFLAKE_DATABASE=BENCH
SNOWFLAKE_SCHEMA=PUBLIC
