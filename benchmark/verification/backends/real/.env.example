# Copy this file to .env and fill only the connectors you plan to run.
# Never commit .env.

# Slack live adapter
SLACK_BOT_TOKEN=
SLACK_CHANNEL_OVERRIDE=

# Google Sheets live adapter
# Google auth is taken from: gcloud auth print-access-token
SHEETS_SPREADSHEET_ID=
SHEETS_TAB=

# Snowflake live adapter
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
# Use one of these auth methods.
SNOWFLAKE_PAT=
SNOWFLAKE_PRIVATE_KEY_PATH=

# Jira live adapter
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Salesforce live adapter
# Salesforce auth is taken from the sf CLI.
SF_ORG=
SF_TARGET_ORG=
