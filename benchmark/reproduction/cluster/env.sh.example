# Site-specific settings for the Slurm launchers in benchmark/reproduction/cluster.
#
# Copy this file to benchmark/reproduction/cluster/env.sh (gitignored) and edit the
# values for your cluster. Every *.sbatch sources it after changing to the
# repository root, and the launchers are submitted with --export=NIL, so this
# file is the only place site paths live. Values already present in the
# environment win over the defaults below.

# Interpreter with the pinned stack from requirements.txt (Python 3.12).
export AGENTORCH_CONDA_BIN="${AGENTORCH_CONDA_BIN:-$HOME/.conda/envs/benchmark/bin}"
export AGENTORCH_PYTHON="${AGENTORCH_PYTHON:-$AGENTORCH_CONDA_BIN/python}"
# Optional second interpreter with a newer vLLM for architectures the pinned
# stack cannot load (used only by the Muse Glimmer ablation lane).
export AGENTORCH_MUSE_PYTHON="${AGENTORCH_MUSE_PYTHON:-$AGENTORCH_PYTHON}"

# Credential files (dotenv format, never committed). AGENTORCH_ENV_FILE holds
# HF_TOKEN and any direct-OpenAI key; AGENTORCH_API_ENV_FILE holds the
# Azure OpenAI / Anthropic keys used by the API-model lanes. Point both at the
# same file if you keep one. See .env.example at the release root for the keys.
export AGENTORCH_ENV_FILE="${AGENTORCH_ENV_FILE:-$AGENTORCH_ROOT/.env}"
export AGENTORCH_API_ENV_FILE="${AGENTORCH_API_ENV_FILE:-$AGENTORCH_ENV_FILE}"

# Hugging Face cache holding the pre-downloaded pinned checkpoints
# (reproduction/cluster/download_scale_extension_models.sh). Jobs run with HF_HUB_OFFLINE=1.
export HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"

# Optional: CUDA toolkit for vLLM's runtime kernel builds. Leave empty to use
# whatever nvcc is already on PATH. AGENTORCH_CUDA_STUBS may name a directory
# of driver stub libraries for nodes without a system libcuda at link time.
export AGENTORCH_CUDA_HOME="${AGENTORCH_CUDA_HOME:-}"
export AGENTORCH_CUDA_STUBS="${AGENTORCH_CUDA_STUBS:-}"

# Optional: Azure OpenAI endpoint for the gpt-4o / gpt-35-turbo lanes
# (the deployment name and API key live in the credential file).
# export AZURE_OPENAI_ENDPOINT="https://<resource>.openai.azure.com"

# Optional: a node to exclude on every submission made by submit_temp_sweep.sh.
export AGENTORCH_SLURM_EXCLUDE="${AGENTORCH_SLURM_EXCLUDE:-}"
