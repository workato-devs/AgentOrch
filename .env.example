# Credentials for the benchmark evaluators and the training launchers. Copy to
# .env (gitignored) at the release root, or point AGENTORCH_ENV_FILE /
# AGENTORCH_API_ENV_FILE in benchmark/reproduction/cluster/env.sh and training/scripts/env.sh
# at your own file. Only the providers you actually use are needed. The
# simulated connector backend needs no connector credentials at all.

# Hugging Face: gated checkpoints (Llama, Gemma, Command R) and the
# Inference-Providers adapter.
HF_TOKEN=

# OpenAI-compatible models (model ids starting with gpt/o1/o3/o4).
# OPENAI_API_MODE=direct uses api.openai.com with OPENAI_API_KEY; otherwise the
# Azure deployment below is used.
OPENAI_API_KEY=
OPENAI_API_MODE=direct
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Anthropic models (model ids starting with claude).
ANTHROPIC_API_KEY=

# Training only (optional): Weights & Biases logging for the SFT / RL launchers.
# Leave empty to run with WANDB_MODE=offline.
WANDB_API_KEY=
